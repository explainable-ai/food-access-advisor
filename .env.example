# AWS authentication: use an IAM role in AWS and an AWS SSO profile locally.
# Do not place access keys in this file. Example local login:
#   aws sso login --profile bedrock-dev
#   $env:AWS_PROFILE="bedrock-dev"
AWS_REGION=us-east-1

# Browser/API boundary. Production must contain only the final published
# Lovable or custom origin. Do not use "*". Add localhost only in a local
# development environment.
FOOD_ACCESS_CORS_ORIGINS=http://localhost:5173

# Staff-only write actions use an Amazon Cognito access token. Keep
# FOOD_ACCESS_AUTH_MODE=required in AWS. ``disabled`` is only for local tests.
FOOD_ACCESS_AUTH_MODE=required
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_STAFF_GROUP=staff

# In-repository Vite frontend. These public client identifiers enable Cognito
# Authorization Code + PKCE; never configure a client secret in a browser app.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173

# Optional: override the default Bedrock model (Claude Haiku 4.5 by default).
# Use a "us." or "eu." prefixed model id if you hit a
# "provisioned throughput" error — some models need a cross-region
# inference profile.
# STRANDS_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Public-data integrations. Census requires a key for API calls; Socrata
# can work without a token at lower rate limits.
CENSUS_API_KEY=
CENSUS_ACS_YEAR=2024
SOCRATA_APP_TOKEN=

# Planned Amazon Location integration. The backend invokes Location through
# its IAM role; never place AWS credentials in the browser.
ROUTING_PROVIDER=amazon_location
AWS_LOCATION_REGION=us-east-1
# The browser never receives AWS credentials. The API uses its IAM role.
# Select the UI's explicit estimate mode for local work without AWS access.

# Evidence quality and deterministic score policy.
MINIMUM_DATA_COMPLETENESS=0.80
SCORING_VERSION=site-priority-v1

# Durable Watchdog persistence. Keep `sqlite` for local/offline development.
# Set `dynamodb` only in a runtime with an IAM role granting access to these
# exact resources; Boto3 uses the role automatically.
WATCHDOG_STORAGE_PROVIDER=sqlite
WATCHDOG_EVIDENCE_TABLE=food-access-watchdog-evidence
FLAGGED_TRACTS_TABLE=food-access-flagged-tracts
EVIDENCE_BUCKET=food-access-evidence-576951331959-us-east-1
