# AWS credentials for Amazon Bedrock (Strands Agents' default model provider).
# Copy this file to .env and fill in real values, or run `aws configure`
# instead and skip this file entirely — Strands picks up either.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
# AWS_SESSION_TOKEN=only-if-using-temporary-credentials

# Optional: override the default Bedrock model (Claude Sonnet 4 by default).
# Use a "us." or "eu." prefixed model id if you hit a
# "provisioned throughput" error — some models need a cross-region
# inference profile.
# STRANDS_MODEL_ID=us.anthropic.claude-sonnet-4-6
