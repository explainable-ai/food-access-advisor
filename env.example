# AWS credentials for Amazon Bedrock (Strands Agents' model provider).
# Copy this file to .env and fill in real values, or run `aws configure`
# instead and skip this file entirely — Strands picks up either.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
# AWS_SESSION_TOKEN=only-if-using-temporary-credentials

# Which Bedrock model both agents use — read by model.py, not Strands
# itself. Defaults to us.anthropic.claude-haiku-4-5-20251001-v1:0 if unset.
# See docs/bedrock-setup.md for the full why/what/how, including the exact
# IAM policy this specific model id needs.
# STRANDS_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
