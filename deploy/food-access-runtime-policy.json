{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseWatchdogEvidence",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:576951331959:table/food-access-watchdog-evidence",
        "arn:aws:dynamodb:us-east-1:576951331959:table/food-access-watchdog-evidence/index/item_type-detected_at-index"
      ]
    },
    {
      "Sid": "UseFlaggedTracts",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:576951331959:table/food-access-flagged-tracts"
    },
    {
      "Sid": "ReadMissionOperationsDemo",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:576951331959:table/food-access-demo-operations"
    },
    {
      "Sid": "ReadWriteEvidenceObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::food-access-evidence-576951331959-us-east-1/snapshots/*",
        "arn:aws:s3:::food-access-evidence-576951331959-us-east-1/resource-cache/*",
        "arn:aws:s3:::food-access-evidence-576951331959-us-east-1/prepared-data/*"
      ]
    },
    {
      "Sid": "ListEvidencePrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::food-access-evidence-576951331959-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "resource-cache/*",
            "prepared-data/*",
            "snapshots/*"
          ]
        }
      }
    },
    {
      "Sid": "InvokeHaikuUSInferenceProfile",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:576951331959:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0"
      ]
    }
  ]
}
